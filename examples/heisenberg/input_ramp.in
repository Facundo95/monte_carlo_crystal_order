Configuration File for Heisenberg Monte Carlo Validation

SIMULATION_METHOD 3
NUM_STEPS 5000
STEPS_TO_OUTPUT 100

FILE_ENTRY ../ising/Ni2AlMn_spin.xyz
FILE_OUTPUT heisenberg_validation.xyz
LATTICE_SIDE 32

ATOM_1 Mn
ATOM_2 Ni
ATOM_3 Al

J_M2 -123.84
J_M3 27.86

T_START 200.0
T_END 400.0
STEP_T 10.0

H_START 0.0
H_END 0.0
STEP_H 1.0

FLAG_SAVE_CONFIG false
FLAG_VERBOSE false
